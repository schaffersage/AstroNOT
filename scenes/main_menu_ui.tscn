[node name="ExplanationLabel" type="Label" parent="MarginContainer/MarginContainer/VBoxContainer" unique_id=1249494200]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Welcome to the ISS! You are now an astronaut about to pilot Dextre, a robotic arm that does routine camera repairs and battery replacements. However, something VERY disastrous went wrong, and now it is up to you, the astronaut, to control Dextre and fix this error.

This is a training simulation, so make sure to take Dextre's motions seriously and not compromise the mission by breaking the ISS.

Good luck and look up!"
horizontal_alignment = 1
autowrap_mode = 2

